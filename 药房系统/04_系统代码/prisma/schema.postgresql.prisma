// 药房信息系统（PIS）Prisma 数据模型
// 由分析类图映射而来，映射规则见 docs/database-design.md（依据 PPT D-设计 P396–403）
// 本文件为 PostgreSQL 版本：由 prisma/schema.prisma 自动派生（node scripts/sync_pg_schema.js）
// 请勿手工编辑本文件——结构必须与 schema.prisma 完全一致，仅 provider 不同
// 用法：cp prisma/schema.postgresql.prisma prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 系统管理员账号（系统级表，不属于核心域实体）
model AdminUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         String   @default("管理员")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_user")
}

// ---------- 描述类 ----------

/// 药品
model Drug {
  id                 Int      @id @default(autoincrement())
  drugCode           String   @unique @map("drug_code")
  name               String
  spec               String?
  manufacturer       String?
  isPrescription     Boolean  @default(false) @map("is_prescription")
  inMedicalInsurance Boolean  @default(false) @map("in_medical_insurance")
  retailPrice        Decimal  @default(0) @map("retail_price")
  costPrice          Decimal  @default(0) @map("cost_price")

  batches    DrugBatch[]
  rules      DisposalRule[]
  traceCodes TraceCode[]

  @@map("drug")
}

/// 处置规则：近效期处置的建议动作（封装老店长的判定逻辑，PPT 改进模式三）
model DisposalRule {
  id              Int     @id @default(autoincrement())
  ruleCode        String  @unique @map("rule_code")
  drugId          Int?    @map("drug_id")
  category        String?
  expiryDays      Int     @map("expiry_days")
  suggestedAction String  @map("suggested_action")
  needApproval    Boolean @default(false) @map("need_approval")

  drug Drug? @relation(fields: [drugId], references: [id])

  @@map("disposal_rule")
}

/// 会员等级
model MemberLevel {
  id              Int     @id @default(autoincrement())
  levelName       String  @unique @map("level_name")
  discountRate    Decimal @map("discount_rate")
  pointRate       Decimal @default(1) @map("point_rate")
  redeemThreshold Int     @default(0) @map("redeem_threshold")

  members Member[]

  @@map("member_level")
}

/// 追溯码（一物一码，国家药监平台下发）
model TraceCode {
  id           Int     @id @default(autoincrement())
  code         String  @unique
  drugId       Int     @map("drug_id")
  batchNo      String  @map("batch_no")
  manufacturer String?
  verified     Boolean @default(false)

  drug    Drug          @relation(fields: [drugId], references: [id])
  records TraceRecord[]

  @@map("trace_code")
}

// ---------- 事物类 ----------

/// 库位
model StorageLocation {
  id               Int     @id @default(autoincrement())
  locationCode     String  @unique @map("location_code")
  shelfNo          String? @map("shelf_no")
  cabinetNo        String? @map("cabinet_no")
  storageCondition String? @map("storage_condition")

  batches DrugBatch[]

  @@map("storage_location")
}

/// 药品批次
model DrugBatch {
  id           Int      @id @default(autoincrement())
  drugId       Int      @map("drug_id")
  locationId   Int?     @map("location_id")
  batchNo      String   @map("batch_no")
  expireDate   DateTime @map("expire_date")
  stockQty     Int      @default(0) @map("stock_qty")
  batchStatus  String   @default("在库") @map("batch_status")
  flowStatus   String   @default("正常") @map("flow_status")

  drug         Drug         @relation(fields: [drugId], references: [id])
  location     StorageLocation? @relation(fields: [locationId], references: [id])
  disposals    ExpiryDisposal[]
  saleItems    SaleItem[]
  rxItems      PrescriptionItem[]
  stocktakeItems StocktakeItem[]
  movements    StockMovement[]
  traceRecords TraceRecord[]

  @@unique([drugId, batchNo], name: "uniq_drug_batch_no")
  @@map("drug_batch")
}

/// 店员（含店长，由岗位区分）
model Staff {
  id               Int      @id @default(autoincrement())
  employeeNo       String   @unique @map("employee_no")
  name             String
  post             String
  pharmacistNo     String?  @map("pharmacist_no")
  pharmacistExpire DateTime? @map("pharmacist_expire")
  hiredDate        DateTime? @map("hired_date")

  shifts       Shift[]
  traceRecords TraceRecord[]
  disposals    ExpiryDisposal[]
  prescriptions Prescription[]
  sales        SaleOrder[]
  initiatedStocktakes Stocktake[] @relation("stocktake_initiator")
  reviewedStocktakes  Stocktake[] @relation("stocktake_reviewer")
  movements    StockMovement[]
  redeemedPointLogs PointLog[] @relation("point_op")
  auditLogs    AuditLog[]

  @@map("staff")
}

/// 会员
model Member {
  id          Int      @id @default(autoincrement())
  cardNo      String   @unique @map("card_no")
  levelId     Int      @map("level_id")
  name        String?
  phone       String?
  birthDate   DateTime? @map("birth_date")
  totalPoints Int      @default(0) @map("total_points")
  healthNote  String?  @map("health_note")

  level MemberLevel @relation(fields: [levelId], references: [id])
  sales SaleOrder[]
  pointLogs PointLog[]

  @@map("member")
}

/// 排班（角色）
model Shift {
  id        Int      @id @default(autoincrement())
  staffId   Int      @map("staff_id")
  workDate  DateTime @map("work_date")
  timeRange String   @map("time_range")
  shiftNo   String   @map("shift_no")

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, workDate, shiftNo], name: "uniq_staff_shift")
  @@map("shift")
}

// ---------- 时刻时段类 ----------

/// 追溯事件（一物一码的每一次扫码：入库 / 销售出库 / 退货入库 / 撤销）
model TraceRecord {
  id            Int      @id @default(autoincrement())
  traceCodeId   Int      @map("trace_code_id")
  staffId       Int      @map("staff_id")
  eventType     String   @default("入库") @map("event_type")
  batchId       Int?     @map("batch_id")
  scannedAt     DateTime @default(now()) @map("scanned_at")
  saleItemId    Int?     @map("sale_item_id")
  syncStatus    String   @default("已同步") @map("sync_status")
  syncedAt      DateTime? @map("synced_at")
  retryCount    Int      @default(0) @map("retry_count")
  revokesId     Int?     @map("revokes_id")

  traceCode TraceCode  @relation(fields: [traceCodeId], references: [id])
  staff     Staff      @relation(fields: [staffId], references: [id])
  batch     DrugBatch? @relation(fields: [batchId], references: [id])

  @@map("trace_record")
}

/// 处方
model Prescription {
  id           Int       @id @default(autoincrement())
  rxNo         String    @unique @map("rx_no")
  staffId      Int?      @map("staff_id")
  doctorName   String    @map("doctor_name")
  doctorLicence String?  @map("doctor_licence")
  rxDate       DateTime  @map("rx_date")
  diagnosis    String?
  rxType       String    @default("电子处方") @map("rx_type")
  channel      String    @default("PIS 手机端") @map("channel")
  autoVerified Boolean   @default(false) @map("auto_verified")
  verifiedAt   DateTime? @map("verified_at")
  reviewerId   Int?      @map("reviewer_id")
  status       String    @default("已归档")
  signHash     String?   @map("sign_hash")
  validUntil   DateTime? @map("valid_until")
  retainedUntil DateTime? @map("retained_until")

  staff Staff?             @relation(fields: [staffId], references: [id])
  items PrescriptionItem[]
  sales SaleOrder[]

  @@map("prescription")
}

/// 处方明细（处方—批次 *:* 经关联表拆解，PPT P400）
model PrescriptionItem {
  id             Int    @id @default(autoincrement())
  prescriptionId Int    @map("prescription_id")
  batchId        Int    @map("batch_id")
  dosage         String

  prescription Prescription @relation(fields: [prescriptionId], references: [id])
  batch        DrugBatch    @relation(fields: [batchId], references: [id])

  @@map("prescription_item")
}

/// 销售单
model SaleOrder {
  id         Int      @id @default(autoincrement())
  orderNo    String   @unique @map("order_no")
  memberId   Int?     @map("member_id")
  staffId    Int      @map("staff_id")
  prescriptionId Int? @map("prescription_id")
  soldAt     DateTime @default(now()) @map("sold_at")
  receivable Decimal  @map("receivable")
  received   Decimal  @map("received")
  payMethod  String   @map("pay_method")
  status     String   @default("已完成")
  isMemberPrice Boolean @default(false) @map("is_member_price")
  pointsEarned  Int     @default(0)     @map("points_earned")
  discountAmount Decimal @default(0)     @map("discount_amount")
  pointsRedeemed Int    @default(0)     @map("points_redeemed")
  insuranceNo    String? @map("insurance_no")
  insuranceAmount Decimal @default(0)    @map("insurance_amount")
  selfPayAmount  Decimal @default(0)     @map("self_pay_amount")

  member Member?    @relation(fields: [memberId], references: [id])
  staff  Staff      @relation(fields: [staffId], references: [id])
  prescription Prescription? @relation(fields: [prescriptionId], references: [id])
  items  SaleItem[]
  movements StockMovement[]
  pointLogs PointLog[]
  returnOf   SaleOrder?  @relation("sale_return", fields: [returnOfId], references: [id])
  returnOfId Int?        @map("return_of_id")
  returns    SaleOrder[] @relation("sale_return")

  @@map("sale_order")
}

/// 销售明细（组合，外键不为空）
model SaleItem {
  id         Int     @id @default(autoincrement())
  saleOrderId Int    @map("sale_order_id")
  batchId    Int     @map("batch_id")
  quantity   Int
  unitPrice  Decimal @map("unit_price")
  amount     Decimal
  isGift     Boolean @default(false) @map("is_gift")
  rewardId   Int?    @map("reward_id")

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id])
  batch     DrugBatch @relation(fields: [batchId], references: [id])
  reward    RewardItem? @relation(fields: [rewardId], references: [id])

  @@map("sale_item")
}

/// 近效期处置
model ExpiryDisposal {
  id            Int      @id @default(autoincrement())
  batchId       Int      @map("batch_id")
  staffId       Int      @map("staff_id")
  action        String
  disposedAt    DateTime @default(now()) @map("disposed_at")
  deviationNote String?  @map("deviation_note")
  applyNo       String?  @map("apply_no")
  quantity      Int      @default(0)
  status        String   @default("已登记")
  approvedBy    Int?     @map("approved_by")
  approvedAt    DateTime? @map("approved_at")
  retryCount    Int      @default(0) @map("retry_count")
  lastError     String?  @map("last_error")
  revokedAt     DateTime? @map("revoked_at")
  revokeReason  String?  @map("revoke_reason")

  batch DrugBatch @relation(fields: [batchId], references: [id])
  staff Staff     @relation(fields: [staffId], references: [id])

  @@map("expiry_disposal")
}

/// 盘点单
model Stocktake {
  id          Int      @id @default(autoincrement())
  takeNo      String   @unique @map("take_no")
  scope       String?
  baseTime    DateTime @map("base_time")
  status      String   @default("进行中")
  initiatedBy Int      @map("initiated_by")
  reviewedBy  Int?     @map("reviewed_by")
  takeMode    String   @default("动态盘点") @map("take_mode")
  finishedAt  DateTime? @map("finished_at")
  approvedAt  DateTime? @map("approved_at")

  initiator Staff? @relation("stocktake_initiator", fields: [initiatedBy], references: [id])
  reviewer  Staff? @relation("stocktake_reviewer", fields: [reviewedBy], references: [id])
  items     StocktakeItem[]
  movements StockMovement[]

  @@map("stocktake")
}

/// 盘点明细（组合，外键不为空）
model StocktakeItem {
  id          Int     @id @default(autoincrement())
  stocktakeId Int     @map("stocktake_id")
  batchId     Int     @map("batch_id")
  bookQty     Int     @map("book_qty")
  countedQty  Int     @default(0) @map("counted_qty")
  actualQty   Int     @map("actual_qty")
  diffQty     Int     @map("diff_qty")
  diffAmount  Decimal @map("diff_amount")
  pendingEntry Boolean @default(false) @map("pending_entry")

  stocktake Stocktake @relation(fields: [stocktakeId], references: [id])
  batch     DrugBatch @relation(fields: [batchId], references: [id])

  @@unique([stocktakeId, batchId], name: "uniq_stocktake_batch")
  @@map("stocktake_item")
}

// ---------- 新增：库存流水（审计）、积分变动、奖励品 ----------

/// 库存变动（任何改数的唯一入口，UC-02 业务规则 4 的落地）
model StockMovement {
  id            Int      @id @default(autoincrement())
  batchId       Int      @map("batch_id")
  movementType  String   @map("movement_type")
  quantity      Int
  qtyBefore     Int      @map("qty_before")
  qtyAfter      Int      @map("qty_after")
  costPrice     Decimal  @default(0) @map("cost_price")
  amount        Decimal  @default(0)
  sourceType    String   @map("source_type")
  sourceId      Int?     @map("source_id")
  staffId       Int?     @map("staff_id")
  occurredAt    DateTime @default(now()) @map("occurred_at")
  remark        String?
  stocktakeId   Int?     @map("stocktake_id")
  saleOrderId   Int?     @map("sale_order_id")

  batch     DrugBatch  @relation(fields: [batchId], references: [id])
  staff     Staff?     @relation(fields: [staffId], references: [id])
  stocktake Stocktake? @relation(fields: [stocktakeId], references: [id])
  saleOrder SaleOrder? @relation(fields: [saleOrderId], references: [id])

  @@map("stock_movement")
}

/// 积分变动（销售得分、兑换扣分、退货回滚）
model PointLog {
  id          Int      @id @default(autoincrement())
  memberId    Int      @map("member_id")
  saleOrderId Int?     @map("sale_order_id")
  changeType  String   @map("change_type")
  points      Int
  balanceAfter Int     @map("balance_after")
  operatedBy  Int?     @map("operated_by")
  occurredAt  DateTime @default(now()) @map("occurred_at")
  remark      String?

  member    Member     @relation(fields: [memberId], references: [id])
  saleOrder SaleOrder? @relation(fields: [saleOrderId], references: [id])
  operator  Staff?     @relation("point_op", fields: [operatedBy], references: [id])

  @@map("point_log")
}

/// 奖励品（描述类：可兑换礼品的目录信息）
model RewardItem {
  id           Int     @id @default(autoincrement())
  rewardCode   String  @unique @map("reward_code")
  name         String
  pointsCost   Int     @map("points_cost")
  stockQty     Int     @default(0) @map("stock_qty")
  levelLimitId Int?    @map("level_limit_id")
  status       String  @default("在售")

  saleItems SaleItem[]

  @@map("reward_item")
}

/// 操作审计日志（谁在何时对哪条业务单据做了什么）
model AuditLog {
  id         Int      @id @default(autoincrement())
  staffId    Int?     @map("staff_id")
  action     String
  targetType String   @map("target_type")
  targetId   Int?     @map("target_id")
  detail     String?
  ip         String?
  createdAt  DateTime @default(now()) @map("created_at")

  staff Staff? @relation(fields: [staffId], references: [id])

  @@map("audit_log")
}
