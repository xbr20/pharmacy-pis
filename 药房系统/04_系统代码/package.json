{
  "name": "pharmacy-pis",
  "version": "1.0.0",
  "private": true,
  "description": "药房信息系统（PIS）——系统分析与设计课程作业的配套可运行系统",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "node scripts/start.js",
    "start:next": "next start -p 3000",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:reset": "prisma migrate reset --force --skip-seed && node prisma/seed.js",
    "test": "node scripts/check.js"
  },
  "dependencies": {
    "@prisma/client": "5.18.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.41",
    "prisma": "5.18.0",
    "tailwindcss": "3.4.10",
    "typescript": "5.5.4"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
